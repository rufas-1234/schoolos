DATABASE_URL=
DATABASE_SSL=true

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SchoolOS
# Enables public school signup, school selection, and switching.
# Public school signups remain pending until a platform admin approves them.
MULTI_SCHOOL_ENABLED=true
# Comma-separated trusted operator emails for /platform/schools (review and manage schools).
# Platform admins can edit school details and archive/restore; archive preserves tenant data.
# This does not grant access to tenant records; add a school membership and permissions separately.
PLATFORM_ADMIN_EMAILS=
# Optional: set this to the existing school's publicId when temporarily disabling multischool.
DEFAULT_SCHOOL_PUBLIC_ID=

BLOB_READ_WRITE_TOKEN=
# Alternatively, configure all five OBJECT_STORAGE_* variables for S3-compatible storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_SCHOOL_NAME=
ALLOW_INITIAL_ADMIN_SEED=false
